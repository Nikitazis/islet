{
  "name": "cstorka",
  "productName": "Cstorka",
  "version": "0.3.0",
  "description": "Шторка в стиле Dynamic Island для Windows: медиа, буфер обмена, закладки, таймер, календарь, система и заметки.",
  "main": "src/main/main.js",
  "author": "nikitazis688",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/Nikitazis/cstorka",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nikitazis/cstorka.git"
  },
  "keywords": [
    "dynamic-island",
    "windows",
    "electron",
    "media-controls",
    "clipboard-history",
    "pomodoro"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "preview": "node scripts/preview.js",
    "check": "node scripts/check.js",
    "test": "node --test \"test/*.test.js\"",
    "icon": "node scripts/make-icon.js",
    "screenshots": "electron scripts/screenshots.js",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win dir",
    "release": "electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.cstorka.app",
    "productName": "Cstorka",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "!src/renderer/dev/**",
      "assets/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Nikitazis",
        "repo": "cstorka",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Cstorka",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "koffi": "^3.3.4"
  }
}
